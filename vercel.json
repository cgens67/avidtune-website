{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/docs/:path*",
      "destination": "/docs.html"
    },
    {
      "source": "/images/:path*",
      "destination": "/images/:path*"
    },
    {
      "source": "/listen",
      "destination": "/listen.html"
    },
    {
      "source": "/:songId([a-zA-Z0-9_-]{11})/:timestamp*",
      "destination": "/listen.html"
    },
    {
      "source": "/:songId([a-zA-Z0-9_-]{11})",
      "destination": "/listen.html"
    }
  ]
}
