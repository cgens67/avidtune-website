{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/docs/:path*",
      "destination": "/docs.html"
    },
    {
      "source": "/images/:path*",
      "destination": "/images/:path*"
    },
    {
      "source": "/listen",
      "destination": "/listen.html"
    },
    {
      "source": "/listen/:path*",
      "destination": "/listen.html"
    },
    {
      "source": "/:songId([a-zA-Z0-9_-]+)",
      "destination": "/listen.html"
    },
    {
      "source": "/:songId([a-zA-Z0-9_-]+)/",
      "destination": "/listen.html"
    },
    {
      "source": "/:songId([a-zA-Z0-9_-]+)/:path*",
      "destination": "/listen.html"
    }
  ]
}
